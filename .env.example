# Copy this file to .env and fill it in. .env stays out of git.
# Free Gemini key: https://aistudio.google.com/apikey
EMPORIO_LLM_API_KEY=

# Optional. Any provider with an OpenAI-compatible API works.
# EMPORIO_LLM_MODEL=gemini-3.5-flash-lite
# EMPORIO_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Sent as medium on Gemini when unset; on other providers it is only sent if set here.
# EMPORIO_LLM_REASONING_EFFORT=medium
# EMPORIO_LLM_TEMPERATURE=0.2
